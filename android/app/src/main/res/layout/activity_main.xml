<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/input_device" />
        <Spinner android:id="@+id/inputSpinner"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/output_device" />
        <Spinner android:id="@+id/outputSpinner"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:id="@+id/routeWarning"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#FFC62828" />

        <TextView style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/preset" />
        <Spinner android:id="@+id/presetSpinner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:entries="@array/presets" />

        <Button android:id="@+id/startButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/start" />

        <Switch android:id="@+id/muteSwitch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/mute" />

        <TextView android:id="@+id/volumeLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <SeekBar android:id="@+id/volumeSeek"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="30" android:progress="20" />

        <TextView android:id="@+id/lowLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <SeekBar android:id="@+id/lowSeek"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="40" />

        <TextView android:id="@+id/midLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/midSeek"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="40" />

        <TextView android:id="@+id/highLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/highSeek"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="40" />

        <TextView android:id="@+id/mpoLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <SeekBar android:id="@+id/mpoSeek"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="24" android:progress="18" />

        <Switch android:id="@+id/feedbackSwitch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:checked="true" android:text="@string/feedback" />

        <TextView android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:fontFamily="monospace" />

        <TextView style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/safety_notice" />
    </LinearLayout>
</ScrollView>
